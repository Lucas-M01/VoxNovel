# Run commands from apps/backend; do not commit .env.
VOXNOVEL_APP_NAME=VoxNovel API
VOXNOVEL_HOST=127.0.0.1
VOXNOVEL_PORT=8000
# JSON array of browser origins; empty denies cross-origin browser access.
VOXNOVEL_CORS_ORIGINS=[]

# Backend-only persistence configuration; leave blank to run the API foundation.
VOXNOVEL_SUPABASE_URL=
# Server secret. Never expose through mobile config or commit its real value.
VOXNOVEL_SUPABASE_SERVICE_KEY=
