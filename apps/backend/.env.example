# Run commands from apps/backend; do not commit .env.
VOXNOVEL_APP_NAME=VoxNovel API
VOXNOVEL_HOST=127.0.0.1
VOXNOVEL_PORT=8000
# JSON array of browser origins; empty denies cross-origin browser access.
VOXNOVEL_CORS_ORIGINS=[]

# Backend-only persistence configuration; leave blank to run the API foundation.
VOXNOVEL_SUPABASE_URL=
# Server secret. Never expose through mobile config or commit its real value.
VOXNOVEL_SUPABASE_SERVICE_KEY=

# First-use defaults only; saved preferences take precedence.
VOXNOVEL_DEFAULT_SPEED=1.5
# Optional JSON arrays: VOXNOVEL_FILTER_WORDS, VOXNOVEL_FILTER_PHRASES,
# VOXNOVEL_FILTER_REGEX. Omit to use the prototype's defaults.

# Precreate a private JSON-only bucket; backend never creates buckets at startup.
VOXNOVEL_SUPABASE_TEXT_BUCKET=downloads
VOXNOVEL_STORAGE_PAGE_SIZE=100

# Scraper budgets apply across redirects and retries; no environment proxy is used.
VOXNOVEL_SCRAPER_DNS_TIMEOUT=5
VOXNOVEL_SCRAPER_REQUEST_TIMEOUT=20
VOXNOVEL_SCRAPER_TOTAL_TIMEOUT=45
VOXNOVEL_SCRAPER_MAX_BYTES=4000000
VOXNOVEL_SCRAPER_MAX_REDIRECTS=5
VOXNOVEL_SCRAPER_RETRIES=2
# VOXNOVEL_SCRAPER_USER_AGENT and VOXNOVEL_SCRAPER_DENIED_NETWORKS
# may override the configured defaults; retain metadata/NAT64 denials.

# Provider endpoints; all requests still pass through the public-network policy.
VOXNOVEL_FREEWEBNOVEL_BASE=https://freewebnovel.com
VOXNOVEL_CENTRALNOVEL_BASE=https://centralnovel.com
VOXNOVEL_NOVELFIRE_BASE=https://novelfire.net
VOXNOVEL_ROYALROAD_BASE=https://www.royalroad.com
# Bound challenge submissions and solver delay, still under the total deadline.
VOXNOVEL_SCRAPER_REQUEST_MAX_BYTES=64000
VOXNOVEL_SCRAPER_CHALLENGE_DELAY=5

# GoogleTranslator auto -> Portuguese, original blocks retained on failure.
VOXNOVEL_GOOGLE_TRANSLATION_BASE=https://translate.google.com/m
VOXNOVEL_TRANSLATION_TIMEOUT=45
VOXNOVEL_TRANSLATION_BLOCK_CHARS=4500
VOXNOVEL_TRANSLATION_BLOCK_DELAY=0.3

# Processing limits; all I/O-heavy handlers run outside the event loop.
VOXNOVEL_PROCESSING_CONCURRENCY=2
VOXNOVEL_PROCESSING_WAIT_TIMEOUT=15
VOXNOVEL_PROCESSING_MAX_CHARS=1000000
VOXNOVEL_FILTER_REGEX_TIMEOUT=0.1
VOXNOVEL_FILTER_MAX_ITEMS=1000
VOXNOVEL_FILTER_MAX_TERM_CHARS=4096
VOXNOVEL_API_MAX_BODY_BYTES=1000000
VOXNOVEL_SERVER_CONCURRENCY_LIMIT=64
# Access logs can contain URL query data; disabled by default.
VOXNOVEL_ACCESS_LOG=false
VOXNOVEL_PERSISTENCE_TIMEOUT=20
VOXNOVEL_TRANSLATION_TOTAL_TIMEOUT=120
VOXNOVEL_TRANSLATION_BLOCK_OUTPUT_CHARS=20000

# Optional one-shot importer only; never expose this connection to the mobile app.
VOXNOVEL_LEGACY_IMPORT_DATABASE_URL=
VOXNOVEL_LEGACY_PSQL_COMMAND=["psql"]
VOXNOVEL_LEGACY_PG_DUMP_COMMAND=["pg_dump"]
VOXNOVEL_LEGACY_IMPORT_TIMEOUT=300
VOXNOVEL_LEGACY_IMPORT_MAX_BYTES=64000000
