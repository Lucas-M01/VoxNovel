{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@pattern/*": [
        "./src/pattern/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts"
  ]
}
